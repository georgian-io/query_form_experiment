# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
# Every secret in this project is read from the environment; nothing is hardcoded.
# src/config.py loads .env automatically; real environment variables take precedence over it.

# --- Retrieval substrate (required for any indexing/retrieval) ---------------
TURBOPUFFER_API_KEY=
# Region of your turbopuffer cluster, e.g. gcp-us-central1 / aws-us-east-1.
# Mind data residency for ChatDoctor (real de-identified patient text).
TURBOPUFFER_REGION=gcp-us-central1

# --- Vertex AI (gemini-embedding-001, Gemini generators) ---------------------
# Auth is Application Default Credentials, so no key goes in this file:
#   gcloud auth application-default login --project <project-id>
# Use the project ID, not its display name -- the two usually differ, and passing
# the display name yields a 403 PERMISSION_DENIED / CONSUMER_INVALID that reads
# like an access problem rather than a wrong identifier.
# gcloud's own default project (`gcloud config set project`) is a separate
# setting and does not affect what the SDK bills.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Novita (open-weight embedders + Llama/Qwen generators) ------------------
NOVITA_API_KEY=

# --- Hosted embedding APIs (contrast + top-10 proprietary models) ------------
OPENAI_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# --- Optional: gated/private HuggingFace datasets ---------------------------
HF_TOKEN=
